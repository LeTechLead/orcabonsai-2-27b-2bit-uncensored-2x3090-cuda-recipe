# Copy to .env and adjust. All values have working defaults in docker-compose.yml.

# ── Images ────────────────────────────────────────────────────────────────────
# The published image. Used by default — nothing to build, so `docker compose up -d`
# pulls it and runs.
SERVICE_IMAGE=ghcr.io/letechlead/orcabonsai-27b-serving:latest

# The three values below apply only when you build from source:
#   docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build
# Build-time base produced by base/Dockerfile (the PrismML llama.cpp fork, CUDA).
BASE_IMAGE=prismml-llama-server:cuda13
# Local tag the ./Dockerfile build is given.
LOCAL_IMAGE=orcabonsai-27b-serving:local
# Upstream ref the LoRA adapter is fetched from at build time.
ORCABONSAI_REF=main

# ── Model ─────────────────────────────────────────────────────────────────────
# Host directory holding the GGUF. Read-only inside the container at /models.
MODEL_DIR=./models
MODEL_FILE=Ternary-Bonsai-2-27B-PQ2_0.gguf

# ── Serving ───────────────────────────────────────────────────────────────────
# Host port to publish.
PORT=8080
# GPU sharding is automatic — llama.cpp spreads the model across every GPU the
# container can see (one card or many, no flag needed). For lopsided cards, add an
# explicit --tensor-split to the command in docker-compose.yml.
# Context window. The model is trained for 262144; it is the practical ceiling because
# llama.cpp clamps requests above the trained context.
BONSAI_CTX=262144
# KV cache precision: q8_0 (default) or q4_0 for roughly half the KV memory.
BONSAI_KV_TYPE=q8_0

# ── Ablation strength ─────────────────────────────────────────────────────────
# 1.0 = the exact refusal-direction projection (the paper measurement).
# 0.0 = the published, unablated model — useful for A/B on identical weights.
# 2.0 = over-projection; flips prompts that still refuse at 1.0, costs coherence.
BONSAI_ALPHA=1.0
